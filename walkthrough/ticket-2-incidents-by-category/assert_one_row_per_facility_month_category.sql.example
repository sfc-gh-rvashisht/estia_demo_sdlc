-- Copy to tests/assert_one_row_per_facility_month_category.sql
-- Each facility, month and category should appear once. No rows means pass.
select facility_id, incident_month, incident_type, count(*) as row_count
from {{ ref('gold_facility_monthly_incidents_by_category') }}
group by facility_id, incident_month, incident_type
having count(*) <> 1
